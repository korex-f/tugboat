#!/usr/bin/env python3
"""Private, local control plane for the Tugboat Quattro plugin."""
import argparse, base64, json, os, re, secrets, shutil, socket, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.request import Request, urlopen

ROOT = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "tugboat"
CONFIG, ARIA_CONF, UNIT, PROXY_UNIT = ROOT / "config.json", ROOT / "aria2.conf", ROOT / "tugboat-aria2.service", ROOT / "tugboat-rpc-proxy.service"

def emit(value): print(json.dumps(value, separators=(",", ":")))
def load(): return json.loads(CONFIG.read_text()) if CONFIG.exists() else None
def free_port():
    s = socket.socket(); s.bind(("127.0.0.1", 0)); port = s.getsockname()[1]; s.close(); return port
def command(*args, check=False): return subprocess.run(args, text=True, capture_output=True, check=check)
def unit_text(): return f"""[Unit]\nDescription=Tugboat aria2 RPC daemon\n[Service]\nExecStart=/usr/bin/aria2c --conf-path={ARIA_CONF}\nRestart=on-failure\nRestartSec=2\n[Install]\nWantedBy=default.target\n"""
def proxy_unit_text(): return f"""[Unit]\nDescription=Tugboat browser RPC proxy\nAfter=tugboat-aria2.service\n[Service]\nExecStart=/usr/bin/python3 {Path(__file__).resolve()} proxy\nRestart=on-failure\nRestartSec=2\n[Install]\nWantedBy=default.target\n"""
def ensure(args):
    if not shutil.which("aria2c"):
        emit({"ok":False,"error":"aria2c is not installed. Install the aria2 package, then reopen this panel."}); return
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    cfg = load()
    migrate_proxy = bool(cfg and "ariaPort" not in cfg)
    desired_port = int(args.port or 0)
    desired_directory = os.path.expanduser(args.directory or "~/Downloads")
    if not cfg:
        cfg = {"port":desired_port or free_port(),"ariaPort":free_port(),"proxyPort":desired_port or 0,"secret":secrets.token_urlsafe(32),"directory":desired_directory,"autoStart":bool(args.auto_start),"createdAt":int(time.time())}
        if not cfg["proxyPort"]: cfg["proxyPort"] = cfg["port"]
        CONFIG.write_text(json.dumps(cfg)); CONFIG.chmod(0o600)
    else:
        # A zero port means "keep the automatically chosen port". Explicit
        # settings changes are applied without exposing the secret in argv.
        cfg["directory"] = desired_directory
        if desired_port: cfg["port"] = desired_port
        if "autoStart" not in cfg: cfg["autoStart"] = bool(args.auto_start)
        if migrate_proxy:
            cfg["ariaPort"] = free_port()
            cfg["proxyPort"] = cfg["port"]
        elif desired_port:
            cfg["proxyPort"] = desired_port
        CONFIG.write_text(json.dumps(cfg)); CONFIG.chmod(0o600)
    Path(os.path.expanduser(cfg["directory"])).mkdir(mode=0o700, parents=True, exist_ok=True)
    ARIA_CONF.write_text("\n".join(["enable-rpc=true", "rpc-listen-all=false", "rpc-allow-origin-all=true", f"rpc-listen-port={cfg['ariaPort']}", f"rpc-secret={cfg['secret']}", f"dir={cfg['directory']}", "continue=true", "bt-enable-lpd=true", "seed-time=0", "file-allocation=none", "summary-interval=0", "max-concurrent-downloads=5"]) + "\n")
    ARIA_CONF.chmod(0o600)
    UNIT.write_text(unit_text())
    CONFIG.write_text(json.dumps(cfg)); CONFIG.chmod(0o600)
    PROXY_UNIT.write_text(proxy_unit_text())
    command("systemctl", "--user", "daemon-reload")
    if cfg["autoStart"]:
        result = command("systemctl", "--user", "enable", "--now", str(UNIT))
        command("systemctl", "--user", "enable", "--now", str(PROXY_UNIT))
    else:
        command("systemctl", "--user", "disable", str(UNIT))
        result = command("systemctl", "--user", "start", str(UNIT))
        command("systemctl", "--user", "disable", str(PROXY_UNIT))
        command("systemctl", "--user", "start", str(PROXY_UNIT))
    if migrate_proxy:
        command("systemctl", "--user", "restart", "tugboat-aria2.service")
        command("systemctl", "--user", "restart", "tugboat-rpc-proxy.service")
    emit({"ok":result.returncode == 0,"error":result.stderr.strip(),"port":cfg["port"]})
def rpc(method, params=[]):
    cfg = load()
    if not cfg: raise RuntimeError("Tugboat has not been provisioned")
    payload = {"jsonrpc":"2.0","id":"oma","method":"aria2."+method,"params":["token:"+cfg["secret"]]+params}
    req = Request(f"http://127.0.0.1:{cfg.get('ariaPort', cfg['port'])}/jsonrpc", data=json.dumps(payload).encode(), headers={"Content-Type":"application/json"})
    response = json.loads(urlopen(req, timeout=3).read())
    if "error" in response: raise RuntimeError(response["error"].get("message", "RPC failed"))
    return response["result"]
def status(_):
    try:
        active = rpc("tellActive", [["gid","status","totalLength","completedLength","downloadSpeed","uploadSpeed","files","bittorrent","numSeeders","errorMessage"]])
        waiting = rpc("tellWaiting", [0, 50, ["gid","status","totalLength","completedLength","downloadSpeed","files","bittorrent","numSeeders","errorMessage"]])
        stopped = rpc("tellStopped", [0, 20, ["gid","status","totalLength","completedLength","downloadSpeed","files","bittorrent","numSeeders","errorMessage"]])
        items = active + waiting + stopped
        # aria2 exposes a short-lived internal magnet metadata transfer as a
        # separate stopped task; it is not a user download.
        items = [item for item in items if not any(str(f.get("path", "")).startswith("[METADATA]") for f in item.get("files", []))]
        emit({"ok":True,"items":items})
    except Exception as e: emit({"ok":False,"error":str(e),"items":[]})
def add(args):
    try:
        if args.torrent:
            data = base64.b64encode(Path(args.torrent).read_bytes()).decode(); gid = rpc("addTorrent", [data])
        else: gid = rpc("addUri", [[args.url]])
        emit({"ok":True,"gid":gid})
    except Exception as e: emit({"ok":False,"error":str(e)})
def action(args):
    try:
        methods={"pause":"pause","resume":"unpause","remove":"remove","pause-all":"pauseAll", "resume-all":"unpauseAll","limit":"changeGlobalOption", "clear-finished":"purgeDownloadResult"}
        params=[] if args.action in ("pause-all", "resume-all", "clear-finished") else ([{"max-overall-download-limit":str(args.limit*1024)}] if args.action == "limit" else [args.gid])
        try:
            result = rpc(methods[args.action], params)
        except Exception:
            if args.action != "remove": raise
            result = rpc("removeDownloadResult", [args.gid])
        emit({"ok":True,"result":result})
    except Exception as e: emit({"ok":False,"error":str(e)})
def info(_):
    cfg = load()
    version = command("aria2c", "--version").stdout.splitlines()
    enabled = command("systemctl", "--user", "is-enabled", "tugboat-aria2.service").returncode == 0
    emit({"ok":cfg is not None, "port":cfg.get("port") if cfg else None,
          "authenticated":bool(cfg and cfg.get("secret")), "autoStart":enabled,
          "version":version[0].strip() if version else "aria2 unavailable"})
def restart(_):
    result = command("systemctl", "--user", "restart", "tugboat-aria2.service")
    emit({"ok":result.returncode == 0,"error":result.stderr.strip()})
def auto_start(args):
    cfg = load()
    if not cfg: emit({"ok":False,"error":"Tugboat has not been provisioned"}); return
    enabled = args.state == "on"
    cfg["autoStart"] = enabled
    CONFIG.write_text(json.dumps(cfg)); CONFIG.chmod(0o600)
    result = command("systemctl", "--user", "enable" if enabled else "disable", "tugboat-aria2.service")
    command("systemctl", "--user", "enable" if enabled else "disable", "tugboat-rpc-proxy.service")
    emit({"ok":result.returncode == 0,"error":result.stderr.strip(),"autoStart":enabled})
def resolve_duplicate(args):
    if not re.fullmatch(r"[0-9a-f]{24}", args.request_id):
        emit({"ok":False,"error":"Invalid duplicate request"}); return
    response = ROOT / f"duplicate-{args.request_id}.json"
    response.write_text(json.dumps({"approved":args.choice == "yes"}))
    response.chmod(0o600)
    emit({"ok":True})
def browser(args):
    cfg=load()
    if not cfg: emit({"ok":False,"error":"Provision aria2 first"}); return
    urls={"firefox":"https://addons.mozilla.org/firefox/addon/aria2-integration/", "chrome":"https://chromewebstore.google.com/detail/aria2-explorer/mpkodccbngfoacfalldjimigbofkhgjn"}
    target="firefox" if args.browser == "firefox" else "chrome"
    subprocess.Popen(["xdg-open", urls[target]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    emit({"ok":True,"browser":target,"config":{"rpcUrl":f"http://127.0.0.1:{cfg.get('proxyPort', cfg['port'])}/jsonrpc","rpcSecret":cfg["secret"]}})

def proxy(_):
    duplicate_lock = threading.Lock()
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_): pass
        def do_POST(self):
            cfg = load()
            try:
                payload = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                def forward(value):
                    method = value.get("method", "")
                    params = value.get("params", [])
                    authorized = bool(params and params[0] == "token:" + cfg["secret"])
                    args = params[1:] if params and params[0] == "token:" + cfg["secret"] else params
                    if authorized and method == "aria2.addUri" and args and args[0]:
                        with duplicate_lock:
                            uri = args[0][0]
                            fields = ["gid", "status", "files", "bittorrent"]
                            # shortcut: only the latest 100 stopped jobs are checked; paginate if users need older history.
                            existing = rpc("tellActive", [fields]) + rpc("tellWaiting", [0, 100, fields]) + rpc("tellStopped", [0, 100, fields])
                            match = next((item for item in existing if any(uri == u.get("uri") for f in item.get("files", []) for u in f.get("uris", []))), None)
                            if match:
                                name = next((Path(f.get("path", "")).name for f in match.get("files", []) if f.get("path")), uri)
                                if not ask_panel(name):
                                    return {"jsonrpc":"2.0", "id":value.get("id"), "error":{"code":-1,"message":"Duplicate download cancelled"}}
                            request = Request(f"http://127.0.0.1:{cfg['ariaPort']}/jsonrpc", data=json.dumps(value).encode(), headers={"Content-Type":"application/json"})
                            return json.loads(urlopen(request, timeout=30).read())
                    request = Request(f"http://127.0.0.1:{cfg['ariaPort']}/jsonrpc", data=json.dumps(value).encode(), headers={"Content-Type":"application/json"})
                    return json.loads(urlopen(request, timeout=30).read())
                output = [forward(item) for item in payload] if isinstance(payload, list) else forward(payload)
                body = json.dumps(output).encode()
                self.send_response(200); self.send_header("Content-Type", "application/json"); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
            except Exception as exc:
                body = json.dumps({"jsonrpc":"2.0", "id":None, "error":{"code":-1,"message":str(exc)}}).encode()
                self.send_response(500); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
    cfg = load()
    ThreadingHTTPServer(("127.0.0.1", cfg["proxyPort"]), Handler).serve_forever()
def ask_panel(name):
    request_id = secrets.token_hex(12)
    response = ROOT / f"duplicate-{request_id}.json"
    try:
        pid = subprocess.run(["pgrep", "-xo", "quickshell"], capture_output=True, text=True, check=True).stdout.strip()
        opened = subprocess.run(["qs", "ipc", "--pid", pid, "call", "io.github.dki.tugboat", "duplicate", request_id, name], capture_output=True, text=True, timeout=5)
        if opened.returncode:
            raise RuntimeError(opened.stderr.strip() or "Could not open the Tugboat panel")
        deadline = time.monotonic() + 120
        while time.monotonic() < deadline:
            try: return bool(json.loads(response.read_text()).get("approved"))
            except FileNotFoundError: time.sleep(0.1)
        return False
    except (subprocess.SubprocessError, OSError, RuntimeError):
        choice = subprocess.run(["notify-send", "--wait", "--action=again=Download again", "--action=cancel=Cancel", "Tugboat: already downloaded or queued", name], capture_output=True, text=True)
        return choice.stdout.strip() == "again"
    finally:
        response.unlink(missing_ok=True)
def main():
    p=argparse.ArgumentParser(); sub=p.add_subparsers(dest="cmd",required=True)
    x=sub.add_parser("ensure"); x.add_argument("--port",type=int); x.add_argument("--directory"); x.add_argument("--auto-start", action="store_true")
    sub.add_parser("status"); x=sub.add_parser("add"); x.add_argument("url",nargs="?"); x.add_argument("--torrent")
    x=sub.add_parser("action"); x.add_argument("action",choices=["pause","resume","remove","pause-all","resume-all","limit","clear-finished"]); x.add_argument("gid",nargs="?"); x.add_argument("--limit",type=int,default=0)
    sub.add_parser("info"); sub.add_parser("restart")
    x=sub.add_parser("auto-start"); x.add_argument("state",choices=["on","off"])
    x=sub.add_parser("browser"); x.add_argument("--browser",choices=["chrome","firefox"],default="chrome")
    x=sub.add_parser("resolve-duplicate"); x.add_argument("request_id"); x.add_argument("choice",choices=["yes","no"])
    sub.add_parser("proxy")
    a=p.parse_args(); {"ensure":ensure,"status":status,"add":add,"action":action,"info":info,"restart":restart,"auto-start":auto_start,"browser":browser,"resolve-duplicate":resolve_duplicate,"proxy":proxy}[a.cmd](a)
if __name__ == "__main__": main()
